var runtime;
var lifetime = 2.0;

var tmp = 0.0;
var i, itmp = 0;
var hobj = 0;
var tmpv3 = { x: 0.0, y: 0.0, z: 0.0 };
var scl_tmp = { x: 0.0, y: 0.0, z: 0.0 };
var dist;
var hprop_pos;
var hprop_scl;
var hprop_rvel;
var hprop_tmp = 0;
var pos = { x: 0.0, y: 0.0, z: 0.0 };
var scl = { x: 0.0, y: 0.0, z: 0.0 };
var rvel = { x: 0.0, y: 0.0, z: 0.0 };

var hobj_parent;
var collision_info;
var coll_init = 0;
var hobj_tmp;

var hobj_sparks;
var hitpoints = 10;

function update(elapsed_seconds)
{
	if (elapsed_seconds == 0.0)
		return;

	runtime += elapsed_seconds;

	if (hitpoints <= 0)
	{
		scl = Vec.mul(scl, 0.95);
		SetPropertyValue(hprop_scl, scl);

		if (Vec.length(scl) < 0.1)
			SetObjFlag(self, "KILL", 1);
	}
}

function init()
{
	runtime = 0.0;

	// cache property handles now so value access is cheaper later

	hprop_pos = FindProperty(self, "Position");

	hprop_scl = FindProperty(self, "Scale");
	scl = GetPropertyValue(hprop_scl);
	hitpoints = Vec.length(scl);

	hprop_rvel = FindProperty(self, "RotationalVelocity");
	rvel.x = Math.toRadians(Math.random(-6.0, 6.0));
	rvel.y = Math.toRadians(Math.random(-6.0, 6.0));
	rvel.z = Math.toRadians(Math.random(-6.0, 6.0));
	SetPropertyValue(hprop_rvel, rvel);

	collision_info = CreateCollisionResults();
	hobj_parent = GetParent(self);
}

function free()
{
	FreeCollisionResults(collision_info);
}

function do_damage(hobj, dmg_dir, dmg_amt, dmg_type)
{
	rvel.x = Math.toRadians(Math.random(-6.0, 6.0));
	rvel.y = Math.toRadians(Math.random(-6.0, 6.0));
	rvel.z = Math.toRadians(Math.random(-6.0, 6.0));
	SetPropertyValue(hprop_rvel, rvel);

	hitpoints -= dmg_amt;
	if (hitpoints <= 0)
	{
		itmp = Math.random(3, 5);
		tmp = 1.1 / itmp;
		scl_tmp = Vec.mul(scl, tmp);

		if (Vec.length(scl_tmp) > 1.0)
		{
			for (i = 0; i < itmp; i++)
			{
				hobj_tmp = CloneObject(self, GetParent(self));

				hprop_tmp = FindProperty(hobj_tmp, "Scale");
				SetPropertyValue(hprop_tmp, scl_tmp);
				
				hprop_tmp = FindProperty(hobj_tmp, "Position");
				tmpv3 = GetPropertyValue(hprop_tmp);
				if (Math.even(i) != 0)
				{
					tmpv3.x += scl_tmp.x / 2.0;
					tmpv3.y -= scl_tmp.y / 2.0;
				}
				else
				{
					tmpv3.x -= scl_tmp.x / 2.0;
					tmpv3.y += scl_tmp.y / 2.0;
				}
				tmpv3.z += scl_tmp.z * Math.random(-1.0, 1.0);
				SetPropertyValue(hprop_tmp, tmpv3);

				hprop_tmp = FindProperty(hobj_tmp, "LinearVelocity");
				tmpv3 = Vec.mul(dmg_dir, 32.0);
				//tmpv3.x += Math.random(-2.0, 2.0);
				//tmpv3.y += Math.random(-2.0, 2.0);
				//tmpv3.z += Math.random(-2.0, 2.0);
				SetPropertyValue(hprop_tmp, tmpv3);

				hprop_tmp = FindProperty(hobj_tmp, "RotationalVelocity");
				tmpv3.x = Math.toRadians(Math.random(-6.0, 6.0));
				tmpv3.y = Math.toRadians(Math.random(-6.0, 6.0));
				tmpv3.z = Math.toRadians(Math.random(-6.0, 6.0));
				SetPropertyValue(hprop_tmp, tmpv3);
				
				hprop_tmp = FindProperty(hobj_tmp, "LinearSpeedFalloffFactor");
				SetPropertyValue(hprop_tmp, 1.0);
			}
		}
		
		hprop_tmp = FindProperty(self, "ScriptUpdateRate");
		SetPropertyValue(hprop_tmp, 0.0);
	}
}