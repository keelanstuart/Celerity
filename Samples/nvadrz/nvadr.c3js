var hmod;
var hscl;
var hparent;
var hexplosion;
var tmp;

var model_file = {};
var model_idx = 0;

var dying = 0;
var time_left = 1.0;
var v3 = { x:0.0, y:0.0, z:0.0 };
var i = 0;

function init()
{
	hmod = FindProperty(self, "ModelFile");
	hscl = FindProperty(self, "Scale");
	hparent = GetParent(self);
	
	model_file[0] = GetPropertyValue(hmod);
	i = model_file[0].lastIndexOf("a.");
	if (i > 0)
		model_file[1] =
			model_file[0].substring(0, i) +
			"b" +
			model_file[0].substring(i + 1, model_file[0].length);
}

function update(elapsed_seconds)
{
	if (dying == 1)
	{
		time_left -= elapsed_seconds;
		if (time_left < 0.0)
		{
			time_left = 0.0;
			SetObjFlag(self, "KILL", 1);
			SetObjFlag(hexplosion, "KILL", 1);
		}
		
		v3.x = time_left;
		v3.y = time_left;
		v3.z = time_left;
		SetPropertyValue(hscl, v3);
	}
}

function hit()
{
	dying = 1;
	hexplosion = CreateObject("explosion", hparent);
	v3 = GetPropertyValue(hpos);
	tmp = FindProperty(hexplosion, "Position");
	SetPropertyValue(tmp, v3);
}

function cycle_model()
{
	model_idx++;
	if (model_idx >= 2)
		model_idx = 0;
	SetPropertyValue(hmod, model_file[model_idx]);
}
