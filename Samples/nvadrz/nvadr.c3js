// Individual invader. No gameplay objects are created after init().

var alive = 1;
var dying = 0;
var death_time = 0.0;
var death_duration = 0.28;
var model_idx = 0;
var score_value = 10;

var hprop_pos;
var hprop_model;
var hprop_scale;
var hparent;
var hgame;
var hexplosion;

var model_file = {};
var base_scale = { x:1.0, y:1.0, z:1.0 };
var pos = { x:0.0, y:0.0, z:0.0 };
var scl = { x:0.0, y:0.0, z:0.0 };
var shot_vel = { x:0.0, y:0.0, z:-12.0 };
var i = 0;
var h = -1;
var model_alt = "b";

function init()
{
	hprop_pos = FindProperty(self, "Position");
	hprop_model = FindProperty(self, "ModelFile");
	hprop_scale = FindProperty(self, "Scale");
	hparent = GetParent(self);
	hgame = GetParent(hparent);

	base_scale = GetPropertyValue(hprop_scale);
	model_file[0] = GetPropertyValue(hprop_model);

	i = model_file[0].lastIndexOf("a.");
	if (i < 0)
	{
		i = model_file[0].lastIndexOf("b.");
		model_alt = "a";
	}
	
	if (i >= 0)
	{
		model_file[1] = model_file[0].substring(0, i) + model_alt +
			model_file[0].substring(i + 1, model_file[0].length);
	}
	else
	{
		model_file[1] = model_file[0];
	}

	if (InEditor() == 0)
	{
		// One explosion per invader: simple, deterministic, and allocation-free in play.
		hexplosion = CreateObject("explosion", hgame);
		SetObjFlag(hexplosion, "DRAW", 0);
	}
}

function update(elapsed_seconds)
{
	if (dying == 0)
		return;

	death_time -= elapsed_seconds;
	if (death_time <= 0.0)
	{
		death_time = 0.0;
		dying = 0;
		SetObjFlag(self, "UPDATE", 0);
		SetObjFlag(self, "DRAW", 0);
		return;
	}

	i = death_time / death_duration;
	scl.x = base_scale.x * i;
	scl.y = base_scale.y * i;
	scl.z = base_scale.z * i;
	SetPropertyValue(hprop_scale, scl);
}

function hit_by_player()
{
	if (alive == 0)
		return;

	alive = 0;
	dying = 1;
	death_time = death_duration;
	SetObjFlag(self, "UPDATE", 1);

	pos = GetPropertyValue(hprop_pos);
	Execute(hexplosion, "explode(" + pos.x + "," + pos.y + "," + pos.z + ");");
	PlaySound("nvadrz/explosion.wav", 0.35, Math.random(0.92, 1.08), 1, pos);

	// Optional game-controller callback.
	if (FunctionExists(hgame, "invader_killed"))
		Execute(hgame, "invader_killed(" + score_value + ");");
}

function fire_enemy(hprojectile)
{
	if (alive == 0)
		return;

	pos = GetPropertyValue(hprop_pos);
	Execute(hprojectile, "fire(" + pos.x + "," + pos.y + "," + pos.z +
		"," + shot_vel.x + "," + shot_vel.y + "," + shot_vel.z +
		"," + self + ",2);");
}

function cycle_model()
{
	if (alive == 0)
		return;

	model_idx++;
	if (model_idx >= 2)
		model_idx = 0;
	SetPropertyValue(hprop_model, model_file[model_idx]);
}

function reset_invader()
{
	alive = 1;
	dying = 0;
	death_time = 0.0;
	model_idx = 0;
	SetPropertyValue(hprop_model, model_file[0]);
	SetPropertyValue(hprop_scale, base_scale);
	SetObjFlag(self, "DRAW", 1);
	SetObjFlag(self, "UPDATE", 0);
}
