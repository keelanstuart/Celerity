// Invader formation movement and fixed enemy-projectile pool.

var hprop_pos;
var hgame;

var move_speed = 0.25;
var drop_speed = 0.5;
var speed_gain = 0.0;
var left_edge = -4.0;
var right_edge = 3.0;

var womp_freq = 0.8;

var enemy_fire_time = 0.75;
var enemy_fire_min = 0.45;
var enemy_fire_max = 1.25;
var enemy_projectile_count = 8;
var enemy_projectile_idx = 0;
var henemy_projectile = [];

var col_count = 0;
var col_idx = 0;
var hcol = -1;
var tmp = 0.0;
var pos = { x:0.0, y:0.0, z:0.0 };
var sound_pos = { x:0.0, y:0.0, z:0.0 };
var i = 0;

function init()
{
	hprop_pos = FindProperty(self, "Position");
	hgame = GetParent(GetParent(self));
	col_count = GetNumChildren(self);

	if (InEditor() == 0)
	{
		// Projectiles live under the gameplay root so their collision query can use
		// that root without intersecting only the invader block.
		for (i = 0; i < enemy_projectile_count; i++)
		{
			henemy_projectile[i] = CreateObject("Projectile", hgame);
			SetObjFlag(enemy_projectile[i], "DRAW", 0);
			SetObjFlag(enemy_projectile[i], "UPDATE", 0);
		}
	}
}

function womp()
{
	ExecuteRecursive(self, "cycle_model();");
	PlaySound("nvadrz/womp.wav", 1.0, womp_freq, 1, sound_pos);
	if (womp_freq < 1.0)
		womp_freq += 0.3;
	else
		womp_freq -= 0.3;
}

function update(elapsed_seconds)
{
	pos = GetPropertyValue(hprop_pos);

	if ((move_speed > 0.0) && (pos.x > right_edge))
	{
		pos.x = right_edge;
		move_speed = -(move_speed + speed_gain);
		pos.z -= drop_speed;
	}
	else if ((move_speed < 0.0) && (pos.x < left_edge))
	{
		pos.x = left_edge;
		move_speed = -move_speed + speed_gain;
		pos.z -= drop_speed;
	}
	else
	{
		pos.x += move_speed;
	}

	womp();

	SetPropertyValue(hprop_pos, pos);

	enemy_fire_time -= elapsed_seconds;
	if ((enemy_fire_time <= 0.0) && (col_count > 0))
	{
		enemy_fire_time = Math.random(enemy_fire_min, enemy_fire_max);

		col_idx = Math.random(0, col_count);
		if (col_idx >= col_count)
			col_idx = col_count - 1;
		hcol = GetChild(self, col_idx);

		if (FunctionExists(hcol, "fire_random"))
			Execute(hcol, "fire_random(" + henemy_projectile[enemy_projectile_idx] + ");");

		enemy_projectile_idx++;
		if (enemy_projectile_idx >= enemy_projectile_count)
			enemy_projectile_idx = 0;
	}
}

function cycle_model()
{
}

function reset_block()
{
	move_speed = 4.0;
	womp_time = 0.0;
	enemy_fire_time = 0.75;
	ExecuteRecursive(self, "reset_invader();");
}
