// Nvadrz player: lateral movement, one-shot-at-a-time firing, lives, and pooling.

var alive = 1;
var dying = 0;
var death_time = 0.0;
var death_duration = 0.70;
var lives = 3;

var move_left = 0.0;
var move_right = 0.0;
var move_speed = 8.0;
var left_edge = -5.0;
var right_edge = 24.0;

var fire_requested = 0;
var fire_cooldown = 0.0;
var fire_cooldown_max = 0.30;
var projectile_speed = 18.0;
var projectile_count = 4;
var projectile_idx = 0;

var hgame;
var hprop_pos;
var hprop_scale;

var pos = { x:0.0, y:0.0, z:0.0 };
var start_pos = { x:0.0, y:0.0, z:0.0 };
var base_scale = { x:1.0, y:1.0, z:1.0 };
var scl = { x:1.0, y:1.0, z:1.0 };
var shot_vel = { x:0.0, y:0.0, z:18.0 };
var i = 0;

function init()
{
	hgame = GetParent(GetParent(self));

	hprop_pos = FindProperty(self, "Position");
	hprop_scale = FindProperty(self, "Scale");
	start_pos = GetPropertyValue(hprop_pos);
	base_scale = GetPropertyValue(hprop_scale);

	SetObjFlag(self, "ACCEPTINPUT", 1);
}

function update(elapsed_seconds)
{
	//Log("move_right: " + move_right + "\n");
	//Log("move_left: " + move_left + "\n");

	if (dying == 1)
	{
		death_time -= elapsed_seconds;
		if (death_time <= 0.0)
		{
			dying = 0;
			if (lives > 0)
				respawn();
			else if (FunctionExists(hgame, "game_over"))
				Execute(hgame, "game_over();");
		}
		return;
	}

	if (alive == 0)
		return;

	pos = GetPropertyValue(hprop_pos);
	pos.x += (move_right - move_left) * move_speed * elapsed_seconds;
	pos.x = Math.range(pos.x, left_edge, right_edge);
	SetPropertyValue(hprop_pos, pos);

	fire_cooldown -= elapsed_seconds;
	if (fire_cooldown < 0.0)
		fire_cooldown = 0.0;

	if ((fire_requested != 0) && (fire_cooldown <= 0.0))
	{
		fire_requested = 0;
		fire_cooldown = fire_cooldown_max;
		pos = GetPropertyValue(hprop_pos);
		shot_vel.z = projectile_speed;

		Execute(hgame, "spawn_projectile(" +
			pos.x + "," + pos.y + "," + pos.z + ","
			shot_vel.x + "," + shot_vel.y + "," + shot_vel.z + ");");

		PlaySound("nvadrz/laser.wav", 0.30, 1.0, 1, pos);
	}
}

function handle_input(action, value)
{
	if (action == "Move Left")
		move_left = value;
	else if (action == "Move Right")
		move_right = value;
	else if (action == "Fire 1")
		fire_requested = 1;
}

function on_hit()
{
	if (alive == 0)
		return;

	alive = 0;
	dying = 1;
	death_time = death_duration;
	lives--;

	move_left = 0.0;
	move_right = 0.0;
	fire_requested = 0;

	pos = GetPropertyValue(hprop_pos);
	Execute(hgame, "spawn_explosion(" +
		pos.x + "," + pos.y + "," + pos.z + ");");

	PlaySound("nvadrz/explosion.wav", 0.55, 0.85, 1, pos);
}

function respawn()
{
	pos.x = start_pos.x;
	pos.y = start_pos.y;
	pos.z = start_pos.z;
	SetPropertyValue(hprop_pos, pos);

	SetPropertyValue(hprop_scale, base_scale);

	SetObjFlag(self, "DRAW", 1);
	alive = 1;
	dying = 0;

	fire_cooldown = 0.5;
}

function reset_player()
{
	lives = 3;
	alive = 1;
	dying = 0;
	respawn();
}
